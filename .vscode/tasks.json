{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Crawler.Api/Crawler.Api.csproj", "/property:GenerateFullPaths=true"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-worker",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Crawler.Worker/Crawler.Worker.csproj", "/property:GenerateFullPaths=true"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "debug-stack: up",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build -d",
      "problemMatcher": []
    },
    {
      "label": "debug-stack: down",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml down",
      "problemMatcher": []
    },
    {
      // Stopping a Docker debug session leaves the app suspended, so each attach configuration restarts its service
      // afterwards (D-32).
      "label": "debug-stack: restart api",
      "type": "process",
      "command": "docker",
      "args": ["compose", "-f", "docker-compose.yml", "-f", "docker-compose.debug.yml", "restart", "api"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "debug-stack: restart worker",
      "type": "process",
      "command": "docker",
      "args": ["compose", "-f", "docker-compose.yml", "-f", "docker-compose.debug.yml", "restart", "worker"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    }
  ]
}
