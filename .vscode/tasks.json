{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Crawler.Api/Crawler.Api.csproj", "/property:GenerateFullPaths=true"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-worker",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Crawler.Worker/Crawler.Worker.csproj", "/property:GenerateFullPaths=true"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "debug-stack: up",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml up --build -d",
      "problemMatcher": []
    },
    {
      "label": "debug-stack: down",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.debug.yml down",
      "problemMatcher": []
    },
    {
      // Installs the vsdbg build the C# extension expects into the running container (D-31); a no-op when it's current.
      "label": "vsdbg: sync api",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/.vscode/sync-vsdbg.mjs", "api"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "vsdbg: sync worker",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/.vscode/sync-vsdbg.mjs", "worker"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    }
  ]
}
